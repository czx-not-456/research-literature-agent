ARG RUNTIME_BASE_IMAGE=python:3.12-slim
FROM ${RUNTIME_BASE_IMAGE}

WORKDIR /app
RUN python -m pip install --no-cache-dir agentarts-sdk==0.1.11
COPY probe_gateway_mcp.py runtime_gateway_probe.py ./
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "runtime_gateway_probe:app", "--host", "0.0.0.0", "--port", "8080"]
